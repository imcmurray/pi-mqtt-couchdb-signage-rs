# Digital Signage Management System - Development Environment
# Copy this file to .env for development setup

# ===== SERVER CONFIGURATION =====
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ===== DATABASE CONFIGURATION =====
COUCHDB_URL=http://localhost:5984
COUCHDB_NAME=digital_signage_dev
COUCHDB_USERNAME=admin
COUCHDB_PASSWORD=admin

# ===== MQTT CONFIGURATION =====
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=signage-management-dev

# ===== SECURITY CONFIGURATION =====
# Development keys - DO NOT USE IN PRODUCTION
API_KEY=dev-api-key-123
TV_TOKEN=dev-tv-token-456
ADMIN_KEY=dev-admin-key-789
SESSION_SECRET=dev-session-secret-change-in-production

# ===== FILE UPLOAD CONFIGURATION =====
MAX_FILE_SIZE=10485760
MAX_FILES_PER_UPLOAD=10
UPLOAD_STORAGE_DIR=./uploads
UPLOAD_TEMP_DIR=./temp

# ===== LAYER SYSTEM CONFIGURATION =====
MAX_LAYERS_PER_TV=10
DEFAULT_LAYER_OPACITY=1.0
COMPOSITING_TIMEOUT=5000
CACHE_LAYER_COMPOSITES=true

# ===== LOGGING CONFIGURATION =====
LOG_LEVEL=debug
ENABLE_FILE_LOGGING=false
LOG_FILE=./logs/app.log
ENABLE_REQUEST_LOGGING=true

# ===== DEVELOPMENT CONFIGURATION =====
ENABLE_DEBUG_ROUTES=true
ENABLE_VERBOSE_ERRORS=true
MOCK_EXTERNAL_SERVICES=false

# ===== PERFORMANCE CONFIGURATION =====
ENABLE_RESPONSE_CACHE=false
CACHE_TIMEOUT=300000
ENABLE_GZIP=true
MAX_CONCURRENT_UPLOADS=5

# ===== RATE LIMITING CONFIGURATION (Relaxed for development) =====
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=10000
RATE_LIMIT_STRICT_MAX=500

# ===== TV DEFAULTS =====
DEFAULT_TRANSITION_EFFECT=fade
DEFAULT_DISPLAY_DURATION=5000
DEFAULT_RESOLUTION=1920x1080
DEFAULT_ORIENTATION=landscape
TV_HEARTBEAT_INTERVAL=30000
TV_HEARTBEAT_TIMEOUT=120000