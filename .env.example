# Digital Signage Management System - Environment Configuration Template
# Copy this file to .env and customize for your environment

# ===== SERVER CONFIGURATION =====
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ===== DATABASE CONFIGURATION =====
COUCHDB_URL=http://couchdb:5984
COUCHDB_NAME=digital_signage
COUCHDB_USERNAME=admin
COUCHDB_PASSWORD=secure-password-here

# ===== MQTT CONFIGURATION =====
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_USERNAME=signage
MQTT_PASSWORD=secure-mqtt-password
MQTT_CLIENT_ID=signage-management

# ===== SECURITY CONFIGURATION =====
# Generate secure random keys for production
API_KEY=your-secure-api-key-here
TV_TOKEN=your-secure-tv-token-here
ADMIN_KEY=your-secure-admin-key-here
SESSION_SECRET=your-secure-session-secret-here

# ===== FILE UPLOAD CONFIGURATION =====
MAX_FILE_SIZE=10485760
MAX_FILES_PER_UPLOAD=10
UPLOAD_STORAGE_DIR=./uploads
UPLOAD_TEMP_DIR=./temp

# ===== LAYER SYSTEM CONFIGURATION =====
MAX_LAYERS_PER_TV=10
DEFAULT_LAYER_OPACITY=1.0
COMPOSITING_TIMEOUT=5000
CACHE_LAYER_COMPOSITES=true

# ===== LOGGING CONFIGURATION =====
LOG_LEVEL=info
ENABLE_FILE_LOGGING=true
LOG_FILE=./logs/app.log
ENABLE_REQUEST_LOGGING=false

# ===== PERFORMANCE CONFIGURATION =====
ENABLE_RESPONSE_CACHE=true
CACHE_TIMEOUT=300000
ENABLE_GZIP=true
MAX_CONCURRENT_UPLOADS=5

# ===== RATE LIMITING CONFIGURATION =====
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_STRICT_MAX=50

# ===== TV DEFAULTS =====
DEFAULT_TRANSITION_EFFECT=fade
DEFAULT_DISPLAY_DURATION=5000
DEFAULT_RESOLUTION=1920x1080
DEFAULT_ORIENTATION=landscape
TV_HEARTBEAT_INTERVAL=30000
TV_HEARTBEAT_TIMEOUT=120000
# ===== COURTHOUSE =====
# "Today" for calendars and the backup schedule
COURT_TIME_ZONE=America/Denver
# NWS forecast for {weather} tokens (defaults: the Frank E. Moss courthouse)
# WEATHER_LATITUDE=40.7608
# WEATHER_LONGITUDE=-111.8910
# WEATHER_LOCATION=Salt Lake City

# ===== NOTIFICATIONS AND BACKUPS =====
# ntfy topic URL (or set it on the System page); keep it secret
# NTFY_URL=https://ntfy.sh/your-secret-topic
# BACKUP_DIR=./backups
# BACKUP_KEEP=7
# BACKUP_SCHEDULE=15 2 * * *
